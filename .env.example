# SMTP genérico (provedores que aceitam usuário/senha).
# Para OAuth2: Outlook `node scripts/configurar-outlook.js`; Gmail `node scripts/configurar-gmail.js`.
# Cada assistente grava seus próprios dados de autenticação neste arquivo .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=seu-email@example.com
SMTP_PASS=sua-senha-de-aplicativo
SMTP_FROM="Gerenciador de Custos <seu-email@example.com>"

# Em produção, use o endereço público HTTPS do aplicativo.
APP_BASE_URL=http://localhost:3000
